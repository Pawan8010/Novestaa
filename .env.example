# ==============================================================================
# Novesta Production Environment Configuration (.env / Render Environment Tab)
# Copy these keys into Render -> Service -> Environment Variables (or local .env).
# NEVER commit a populated .env file to GitHub.
# ==============================================================================

# 1. Server & Custom Domain Runtime (Render sets PORT automatically)
NODE_ENV="production"
PORT="3000"
APP_URL="https://novesta.online"

# 2. Primary Email Transport — Hostinger SSL SMTP (hello@novesta.online)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="hello@novesta.online"
SMTP_PASS=""
SMTP_FROM="Novesta <hello@novesta.online>"
CONTACT_TO_EMAIL="hello@novesta.online"
FOUNDER_BACKUP_EMAIL="rajputpawan9765@gmail.com"

# 3. Optional Fallback Email Transport — Resend API (optional if Hostinger SMTP is set)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Novesta <hello@novesta.online>"

# 4. Razorpay Live Checkout & Webhook
# Get rzp_live_... keys from Razorpay Dashboard -> Account & Settings -> API Keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# 5. Founder Admin Workspace (/admin) — Two-Way Login (Passkey + 6-Digit Email Code)
# FOUNDER_ADMIN_KEY: Choose a strong 16+ char passkey for instant passkey unlock.
# FOUNDER_EMAILS: Comma-separated founder emails allowed to receive 6-digit OTP login codes.
# Generate SESSION_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FOUNDER_ADMIN_KEY=""
FOUNDER_EMAILS="rajputpawan9765@gmail.com,hello@novesta.online,novesta111@gmail.com"
SESSION_SECRET=""

# 6. Shared Cloud Persistence for Render Free Tier (Optional — Free Forever on Upstash)
# Ensures roles, orders, leads, and feedback survive Render Free Tier restarts & deploys
# and stay synced for all visitors worldwide.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# 7. Maps, Analytics & Search Console (Client Build Vars — embedded during npm run build)
VITE_GOOGLE_MAPS_API_KEY=""
VITE_GA4_MEASUREMENT_ID=""
VITE_GSC_VERIFICATION=""